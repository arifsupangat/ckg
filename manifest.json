{
  "manifest_version": 3,
  "name": "Layanan CKG",
  "version": "2.3",
  "description": "Input Pelayanan CKG",
  "permissions": ["tabs", "storage", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sehatindonesiaku.kemkes.go.id/*",
        "https://form.kemkes.go.id/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}

